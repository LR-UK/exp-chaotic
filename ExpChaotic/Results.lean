import Mathlib.Dynamics.Transitive
import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.Analysis.Complex.Exponential
import Mathlib.GroupTheory.GroupAction.IterateAct
import Mathlib.Topology.UniformSpace.Uniformizable
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Topology.Compactification.OnePoint.Basic
import ExpChaotic.Normality
import ExpChaotic.PaperConsequences
import ExpChaotic.Spherical

/-!
# Public results: the exponential map is chaotic

The benchmark definitions and theorem statements intentionally match `Challenge.lean`.
Both `ExpChaotic` and the Palomar solution entry point `Solution` import this module.

The goal is a formalisation of the main results in the paper
"The Exponential Map is Chaotic: An Invitation to Transcendental Dynamics"
by Zhaiming Shen and Lasse Rempe-Gillen.

The formalisation was carried out with the help of Generative AI, including
Microsoft 365 Copilot, Claude and particularly ChatGPT.

The proofs use the paper and, for the initial proof architecture underlying density of the
escaping set, John Harrison's HOL Light formalisation of Misiurewicz's original proof.
See the opening comment of `Challenge.lean` for the author's review and the paper coverage.
-/

open Function Filter Set Metric

namespace ExpChaotic

noncomputable section

/-- The `n`-th iterate of the complex exponential map. -/
abbrev expIterate (n : ℕ) : ℂ → ℂ := Complex.exp^[n]

/-- A point escapes if its orbit eventually leaves every centred Euclidean ball. -/
def EscapesToInfinity (z : ℂ) : Prop :=
  ∀ R : ℝ, ∃ N : ℕ, ∀ n : ℕ, (n ≥ N → R ≤ ‖expIterate n z‖)

/-- The escaping set of the complex exponential map. -/
def escapingSet : Set ℂ := {z | EscapesToInfinity z}

/-- The set of points with dense forward orbit. -/
def denseOrbitSet : Set ℂ :=
  {z | Dense (MulAction.orbit (IterateMulAct Complex.exp) z)}

/-- The repelling periodic points of the complex exponential map. -/
def repellingPeriodicSet : Set ℂ :=
  {p | ∃ n : ℕ, 0 < n ∧ IsPeriodicPt Complex.exp n p ∧
    1 < ‖deriv (expIterate n) p‖}

/-- The Riemann sphere as the one-point compactification of the complex plane. -/
abbrev RiemannSphere := OnePoint ℂ

/-- The canonical uniform structure on the compact Hausdorff Riemann sphere. -/
instance riemannSphereUniformSpace : UniformSpace RiemannSphere :=
  uniformSpaceOfCompactR1

/-- A sequence of maps is normal on `U` if every subsequence has a further subsequence
converging locally uniformly on `U` to some function from `U` to the uniform codomain. -/
def IsNormalSequenceOn {α β : Type*} [TopologicalSpace α] [UniformSpace β]
    (F : ℕ → α → β) (U : Set α) : Prop :=
  ∀ φ : ℕ → ℕ, StrictMono φ →
    ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ g : U → β,
      TendstoLocallyUniformly (fun n (z : U) => F (φ (ψ n)) z) g atTop

/-- The Fatou set defined by local normality of the sphere-valued iterates. -/
def fatouSet (f : ℂ → ℂ) : Set ℂ :=
  {z | ∃ U : Set ℂ, IsOpen U ∧ z ∈ U ∧
    IsNormalSequenceOn (fun n z => ((f^[n]) z : RiemannSphere)) U}

/-- The Julia set, defined as the complement of the Fatou set. -/
def juliaSet (f : ℂ → ℂ) : Set ℂ := (fatouSet f)ᶜ

/-- Continuity, dense periodic points, and Mathlib's topological transitivity
for the monoid action generated by iteration. -/
def IsDevaneyChaotic (f : ℂ → ℂ) : Prop :=
  Continuous f ∧ Dense (Function.periodicPts f) ∧
    MulAction.IsTopologicallyTransitive (IterateMulAct f) ℂ

/-- The plane-valued exponential iterates, included into the Riemann sphere. -/
def sphericalExpIterate (n : ℕ) (z : ℂ) : RiemannSphere :=
  (expIterate n z : OnePoint ℂ)

/-- Corollary 5.5. Given a prescribed compact set K that omits zero,
every sufficiently high iterate of a nonempty open set covers K. -/
theorem eventually_covers_compact
    {U K : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    (hK : IsCompact K) (hK0 : (0 : ℂ) ∉ K) :
    ∃ N : ℕ, ∀ n : ℕ, (n ≥ N → K ⊆ expIterate n '' U) := by
  exact ExponentialJuliaSetMisiurewicz.eventually_covers_compact hU hUne hK hK0

/-- The full iterated preimage of every nonzero point is dense. -/
theorem dense_iteratedPreimages_nonzero {w : ℂ} (hw : w ≠ 0) :
    Dense {z : ℂ | ∃ n : ℕ, expIterate n z = w} := by
  exact ExponentialJuliaSetMisiurewicz.dense_iterated_preimages_nonzero hw

/-- The full iterated preimage of the real axis is dense. -/
theorem dense_iteratedPreimages_realAxis :
    Dense {z : ℂ | ∃ n : ℕ, (expIterate n z).im = 0} := by
  simpa [ExponentialJuliaSetMisiurewicz.OnRealAxis] using
    ExponentialJuliaSetMisiurewicz.dense_iterated_preimages_real_axis

/-- Theorem 1.1, part 1., and Theorem 4.1: Escaping points are dense. -/
theorem dense_escapingSet : Dense escapingSet := by
  exact ExponentialJuliaSetMisiurewicz.dense_escapingSet_exp

/-- Theorem 1.1, part 2.: Points with dense forward orbit are dense. -/
theorem dense_denseOrbitSet : Dense denseOrbitSet := by
  exact ExponentialJuliaSetMisiurewicz.dense_denseOrbitSet_exp

/-- Corollary 5.6. There are uncountably many points with dense forward orbit. -/
theorem not_countable_denseOrbitSet : ¬ denseOrbitSet.Countable := by
  exact ExponentialJuliaSetMisiurewicz.not_countable_denseOrbitSet_exp

/-- Theorem 1.1, part 3., and Theorem 6.1: (Repelling) periodic points are dense. -/
theorem dense_repellingPeriodicSet : Dense repellingPeriodicSet := by
  exact ExponentialJuliaSetMisiurewicz.dense_repelling_periodic_points

/-- Theorem 5.1. The action generated by iterating the exponential map is
topologically transitive. -/
theorem topologically_transitive :
    MulAction.IsTopologicallyTransitive (IterateMulAct Complex.exp) ℂ := by
  exact ExponentialJuliaSetMisiurewicz.topologically_transitive_exp

/-- Theorem 1.2. The exponential map is chaotic in Devaney's sense. -/
theorem devaney_chaotic : IsDevaneyChaotic Complex.exp := by
  exact ExponentialJuliaSetMisiurewicz.devaney_chaotic_exp

/-- Corollary 4.4 (reformulated): The sphere-valued iterates are not equicontinuous
at any point of the plane. -/
theorem not_equicontinuousAt_sphericalExpIterate (z : ℂ) :
    ¬ EquicontinuousAt sphericalExpIterate z := by
  exact ExponentialJuliaSetMisiurewicz.not_equicontinuousAt_sphericalExpIterate z

/-- Theorem 4.3: infinitely many iterated images of a nonempty open set meet the
negative real axis. Strict negativity strengthens the nonpositive-axis statement in the paper. -/
theorem infinitely_often_hits_negative_realAxis {U : Set ℂ}
    (hU : IsOpen U) (hUne : U.Nonempty) :
    {n : ℕ | ∃ z ∈ U, (expIterate n z).im = 0 ∧ (expIterate n z).re < 0}.Infinite := by
  exact ExponentialJuliaSetMisiurewicz.infinitely_often_hits_negative_realAxis hU hUne

/-- Corollary 4.4, in the precise form of Definition 2.3. The arbitrary positive constants
give Exercise 8.7 as well; the conclusion even holds at every sufficiently late time. -/
theorem spherical_sensitive_dependence_paper {U : Set ℂ}
    (hU : IsOpen U) (hUne : U.Nonempty) {R δ : ℝ} (hR : 0 < R) (hδ : 0 < δ) :
    ∃ N : ℕ, ∀ n : ℕ, (n ≥ N → ∃ z ∈ U, ∃ w ∈ U,
      ‖expIterate n z‖ ≤ R ∧ δ ≤ ‖expIterate n z - expIterate n w‖) := by
  exact ExponentialJuliaSetMisiurewicz.spherical_sensitive_dependence_paper hU hUne hR hδ

/-- Observation 5.2: along any escaping orbit, the real parts and the norms of the
derivatives of the iterates both tend to positive infinity. -/
theorem expansion_along_escaping_orbits {z : ℂ} (hz : EscapesToInfinity z) :
    Tendsto (fun n => (expIterate n z).re) atTop atTop ∧
      Tendsto (fun n => ‖deriv (expIterate n) z‖) atTop atTop := by
  exact ⟨ExponentialJuliaSetMisiurewicz.EscapesToInfinity.tendsto_re hz,
    ExponentialJuliaSetMisiurewicz.EscapesToInfinity.tendsto_norm_deriv hz⟩

/-- No increasing subsequence of the iterates has a locally uniform spherical limit
on a nonempty open set. The arbitrary sphere-valued limit is defined only on that set. -/
theorem not_tendstoLocallyUniformly_sphericalExpIterate
    {U : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    {φ : ℕ → ℕ} (hφ : StrictMono φ) (g : U → RiemannSphere) :
    ¬ TendstoLocallyUniformly (fun n (z : U) => sphericalExpIterate (φ n) z) g atTop := by
  apply ExponentialJuliaSetMisiurewicz.not_tendstoLocallyUniformly_expIterate_comp
    (q := fun w : ℂ => (w : RiemannSphere)) OnePoint.continuous_coe _ hU hUne hφ g
  exact fun h => (by norm_num : (1 : ℂ) ≠ 2) (OnePoint.coe_injective h)

/-- Misiurewicz's theorem: the Julia set is the whole complex plane. -/
theorem juliaSet_exp : juliaSet Complex.exp = Set.univ := by
  exact ExponentialJuliaSetMisiurewicz.misiurewicz_juliaSet_exp

/-- No strictly increasing subsequence of the iterates has a locally uniform spherical
limit on a nonempty open set. The limit is allowed to be any sphere-valued function.
This directly rules out normality in the sphere-valued formulation, using Mathlib's
`TendstoLocallyUniformlyOn`. All iterates have domain `ℂ`. -/
theorem not_tendstoLocallyUniformlyOn_sphericalExpIterate
    {U : Set ℂ} (hU : IsOpen U) (hUne : U.Nonempty)
    {φ : ℕ → ℕ} (hφ : StrictMono φ) (g : ℂ → RiemannSphere) :
    ¬ TendstoLocallyUniformlyOn (fun n => sphericalExpIterate (φ n)) g atTop U := by
  exact ExponentialJuliaSetMisiurewicz.not_tendstoLocallyUniformlyOn_sphericalExpIterate
    hU hUne hφ g


end

end ExpChaotic
